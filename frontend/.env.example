# Copy this file to .env and adjust. Vite only exposes variables that start with VITE_.
# Do NOT put the API key here for a deployed site: anything in the build is public.
# Paste the key in the app's Settings box instead; it stays in your own browser.
VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY_HEADER=X-API-Key
